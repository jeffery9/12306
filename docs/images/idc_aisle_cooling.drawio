<mxfile host="Electron" version="20.0.0" type="device"><diagram id="diagram_cooling_3d" name="3D Precision Cooling Loop"><mxGraphModel dx="1400" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="room" value="12306 IDC Server Room - 3D Isometric Aisle Cooling &amp; Airflow Loop" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#f8f9fa;strokeColor=#495057;strokeWidth=3;fontStyle=1;align=center;verticalAlign=top;spacingTop=15;fontSize=14;fontColor=#212529;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="40" width="740" height="880" /></mxCell><mxCell id="ceiling_plane" value="Ceiling Hot Return Plenum (吊顶热风回风层 - Z=350)" style="shape=parallelogram;fixedSize=1;fillColor=#fff5f5;strokeColor=#fa5252;opacity=35;strokeWidth=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=50;spacingTop=10;fontColor=#c92a2a;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="100" width="520" height="180" /></mxCell><mxCell id="crac_intake" value="空调上回风口&#10;(AC Intake)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe3e3;strokeColor=#c9184a;fontSize=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="200" y="160" width="90" height="40" /></mxCell><mxCell id="exhaust_hood" value="吊顶负压排风罩&#10;(Ceiling Hood)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe3e3;strokeColor=#c9184a;fontSize=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="460" y="160" width="120" height="40" /></mxCell><mxCell id="equip_plane" value="Equipment &amp; Sealed Aisle Plane (物理设备与冷通道层 - Z=180)" style="shape=parallelogram;fixedSize=1;fillColor=#f8f9fa;strokeColor=#495057;opacity=45;strokeWidth=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=50;spacingTop=10;fontColor=#212529;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="340" width="520" height="240" /></mxCell><mxCell id="crac_body" value="精密空调机组&#10;(Precision CRAC)&#10;- 下送风 / 上回风&#10;- 物理运行中轴" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4fd;strokeColor=#339af0;strokeWidth=2;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#1864ab;" vertex="1" parent="1"><mxGeometry as="geometry" x="180" y="400" width="120" height="130" /></mxCell><mxCell id="rack_a" value="服务器机架排 A&#10;(Rack A)&#10;- ticketing-web&#10;- 42U 标准部署" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dee2e6;strokeColor=#495057;fontSize=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="330" y="410" width="80" height="90" /></mxCell><mxCell id="cac_mid" value="密闭冷通道&#10;(Sealed CAC)&#10;[ 22℃ ± 2℃ ]&#10;密闭钢化吊顶" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f2ff;strokeColor=#339af0;strokeWidth=2;fontStyle=1;fontSize=10;fontColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="410" width="80" height="90" /></mxCell><mxCell id="rack_b" value="服务器机架排 B&#10;(Rack B)&#10;- Redis Cluster&#10;- MySQL Shards" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dee2e6;strokeColor=#495057;fontSize=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="530" y="410" width="80" height="90" /></mxCell><mxCell id="floor_plane" value="Underfloor Pressurized Plenum (架空地板冷风风道层 - Z=0)" style="shape=parallelogram;fixedSize=1;fillColor=#e7f5ff;strokeColor=#339af0;opacity=35;strokeWidth=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=50;spacingTop=10;fontColor=#1864ab;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="660" width="520" height="180" /></mxCell><mxCell id="crac_out" value="空调底部下送风口&#10;(AC Discharge)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0ebff;strokeColor=#1971c2;fontSize=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="200" y="720" width="90" height="40" /></mxCell><mxCell id="floor_tiles" value="地板透气风口&#10;(Perforated Tiles)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0ebff;strokeColor=#1971c2;fontSize=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="720" width="80" height="40" /></mxCell><mxCell id="ac_down" value="1. AC下送风" style="edgeStyle=straight;rounded=0;html=1;strokeColor=#1c7ed6;strokeWidth=3;endArrow=block;fontSize=9;fontColor=#1864ab;fontStyle=1;" edge="1" parent="1" source="crac_body" target="crac_out"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="air_rise" value="3. 冷气上升压入冷通道" style="edgeStyle=straight;rounded=0;html=1;dashed=1;strokeColor=#1c7ed6;strokeWidth=3;endArrow=block;fontSize=9;fontColor=#1864ab;fontStyle=1;" edge="1" parent="1" source="floor_tiles" target="cac_mid"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="exhaust_a" value="5. 换热排风上升" style="edgeStyle=straight;rounded=0;html=1;dashed=1;strokeColor=#fa5252;strokeWidth=3;endArrow=block;fontSize=9;fontColor=#c92a2a;fontStyle=1;" edge="1" parent="1" source="rack_a" target="exhaust_hood"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="exhaust_b" value="" style="edgeStyle=straight;rounded=0;html=1;dashed=1;strokeColor=#fa5252;strokeWidth=3;endArrow=block;fontSize=9;fontColor=#c92a2a;fontStyle=1;" edge="1" parent="1" source="rack_b" target="exhaust_hood"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ac_up" value="7. 空调负压抽风" style="edgeStyle=straight;rounded=0;html=1;strokeColor=#fa5252;strokeWidth=3;endArrow=block;fontSize=9;fontColor=#c92a2a;fontStyle=1;" edge="1" parent="1" source="crac_intake" target="crac_body"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="underfloor_flow" value="2. 架空地板高压送冷风" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1c7ed6;strokeWidth=3;fontSize=9;fontColor=#1864ab;fontStyle=1;" edge="1" parent="1" source="crac_out" target="floor_tiles"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="rack_a_cool" value="4. 进风" style="edgeStyle=straight;rounded=0;html=1;strokeColor=#1c7ed6;strokeWidth=2;fontSize=9;fontColor=#1864ab;" edge="1" parent="1" source="cac_mid" target="rack_a"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="rack_b_cool" value="4. 进风" style="edgeStyle=straight;rounded=0;html=1;strokeColor=#1c7ed6;strokeWidth=2;fontSize=9;fontColor=#1864ab;" edge="1" parent="1" source="cac_mid" target="rack_b"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ceiling_flow" value="6. 吊顶负压热风回流" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#fa5252;strokeWidth=3;fontSize=9;fontColor=#c92a2a;fontStyle=1;" edge="1" parent="1" source="exhaust_hood" target="crac_intake"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>